{
  "name": "proofopolis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A proof-backed isometric city-building game for Creditcoin and Attestcoin.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "check": "npm run test && npm run contracts:compile && npm run build"
  },
  "dependencies": {
    "@gluwa/asc-contracts": "0.2.1",
    "@gluwa/usc-sdk": "0.18.0",
    "ethers": "6.15.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.5",
    "solc": "0.8.30",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
